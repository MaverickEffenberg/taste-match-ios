<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- Allows outbound TCP connections (Supabase HTTPS, Google OAuth) -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- App Sandbox must be enabled for Mac App Store / notarization.
         If you are NOT distributing on the Mac App Store you can set this
         to false, but the network.client key above still applies. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

</dict>
</plist>
